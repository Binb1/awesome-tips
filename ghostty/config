# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms




# Config generated by Ghostty Config


# Follows macOS appearance: custom theme variants for both modes,
# from ~/.config/ghostty/themes/.
theme = light:latte-custom,dark:mocha-custom

# window padding controls
window-padding-color = extend
window-colorspace = "display-p3"
window-save-state = always


# shell integration ("no-cursor" stops it forcing a steady cursor at the
# prompt, so the blinking style below actually applies)
shell-integration = detect
shell-integration-features = no-cursor

# blinking block cursor
cursor-style = block
cursor-style-blink = true


# macos specific features
macos-titlebar-style = tabs
macos-option-as-alt = true

alpha-blending = "native"

# forces dim/faint text (which no palette entry controls) to stay readable
minimum-contrast = 1.7

macos-icon = blueprint

# Herdr: forward ghostty-style shortcuts as Herdr prefix sequences
# (\x02 = Ctrl+B, Herdr's prefix key). These replace ghostty's native
# splits/tabs so Herdr owns the layout. If you run ghostty without
# Herdr, these keys will type control characters into the shell.
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+t=text:\x02N
keybind = cmd+alt+t=text:\x02c
keybind = cmd+alt+left=text:\x02h
keybind = cmd+alt+right=text:\x02l
keybind = cmd+alt+up=text:\x02k
keybind = cmd+alt+down=text:\x02j

# Native ghostty escape hatches: original action on the same key plus
# shift (or ctrl where shift was taken by a Herdr binding above)
keybind = cmd+shift+t=new_tab
keybind = cmd+ctrl+d=new_split:right
keybind = cmd+ctrl+shift+d=new_split:down
keybind = cmd+shift+alt+left=goto_split:left
keybind = cmd+shift+alt+right=goto_split:right
keybind = cmd+shift+alt+up=goto_split:up
keybind = cmd+shift+alt+down=goto_split:down

# Jumping: cmd+N = Herdr workspace N (herdr config maps prefix+digit to
# workspaces), cmd+alt+N = Herdr tab N (esc+digit = alt+digit chord),
# alt+shift+N = ghostty tab N (cmd+shift+3/4/5 are macOS screenshot keys)
keybind = cmd+alt+digit_1=text:\x1b1
keybind = cmd+alt+digit_2=text:\x1b2
keybind = cmd+alt+digit_3=text:\x1b3
keybind = cmd+alt+digit_4=text:\x1b4
keybind = cmd+alt+digit_5=text:\x1b5
keybind = cmd+alt+digit_6=text:\x1b6
keybind = cmd+alt+digit_7=text:\x1b7
keybind = cmd+alt+digit_8=text:\x1b8
keybind = cmd+alt+digit_9=text:\x1b9
keybind = cmd+digit_1=text:\x021
keybind = cmd+digit_2=text:\x022
keybind = cmd+digit_3=text:\x023
keybind = cmd+digit_4=text:\x024
keybind = cmd+digit_5=text:\x025
keybind = cmd+digit_6=text:\x026
keybind = cmd+digit_7=text:\x027
keybind = cmd+digit_8=text:\x028
keybind = cmd+digit_9=text:\x029
keybind = alt+shift+digit_1=goto_tab:1
keybind = alt+shift+digit_2=goto_tab:2
keybind = alt+shift+digit_3=goto_tab:3
keybind = alt+shift+digit_4=goto_tab:4
keybind = alt+shift+digit_5=goto_tab:5
keybind = alt+shift+digit_6=goto_tab:6
keybind = alt+shift+digit_7=goto_tab:7
keybind = alt+shift+digit_8=goto_tab:8
keybind = alt+shift+digit_9=goto_tab:9

