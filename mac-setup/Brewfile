# New Mac setup — run with: brew bundle --file=mac-setup/Brewfile
# App Store apps need you signed in to the App Store first.

# ── CLI ──────────────────────────────────────────────
brew "herdr"         # terminal multiplexer for AI agents
brew "mas"           # installs the App Store apps below
brew "gh"
brew "starship"
brew "nvm"           # node — then: nvm install --lts
brew "pnpm"
brew "pyenv"         # python — then: pyenv install 3.12
brew "uv"

